# ==============================================================================
# BookRent Bot - Production Environment Configuration Template
# Copy this file to '.env' and fill in actual values.
# NEVER commit the '.env' file containing real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials
# ------------------------------------------------------------------------------
# Telegram Bot Token obtained from @BotFather
# Format: <bot_id>:<secret_token> (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_123456)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_YourBotTokenHere

# Comma-separated list of Telegram User IDs for system administrators / owners
# Example: 123456789,987654321
ADMIN_USER_IDS=123456789

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# PostgreSQL connection string in standard SQLAlchemy format:
# postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
# For production, create a dedicated unprivileged user and database:
#   CREATE USER bookrent_user WITH PASSWORD 'your_strong_password_here';
#   CREATE DATABASE bookrent_db OWNER bookrent_user;
DATABASE_URL=postgresql+psycopg2://bookrent_user:your_strong_password_here@localhost:5432/bookrent_db

# ------------------------------------------------------------------------------
# 3. Environment & Logging
# ------------------------------------------------------------------------------
# Application Environment: 'production', 'development', or 'testing'
APP_ENV=production

# Logging Severity Level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. Rental Business Rules & Scheduling
# ------------------------------------------------------------------------------
# Configurable Rental Timezone (valid IANA timezone name)
# Used for rental calendar due-date calculations and operating hours
RENTAL_TIMEZONE=UTC

# Daily overdue penalty rate in Ethiopian Birr (ETB)
OVERDUE_FEE_PER_DAY=5.00

# Fixed 5-day rental extension fee in Ethiopian Birr (ETB)
EXTENSION_FEE=10.00

# Duration of each rental extension in calendar days
EXTENSION_DURATION_DAYS=5

# Interval in hours for the automated overdue detection and notification job
SCHEDULER_INTERVAL_HOURS=24

# ------------------------------------------------------------------------------
# 5. Phase 8: Verification & Notification Settings
# ------------------------------------------------------------------------------
# Broadcast newly added book titles to all approved customers (true/false)
ANNOUNCE_NEW_BOOKS=false

# Number of retry attempts for failed Telegram event notifications
NOTIFICATION_RETRY_ATTEMPTS=2

# Number of days to retain National ID photos before scheduled deletion
ID_RETENTION_DAYS=365

# Privacy policy version string presented to customers during registration
CONSENT_POLICY_VERSION=1.0

